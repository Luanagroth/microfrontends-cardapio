generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Reservation {
  id         Int      @id @default(autoincrement())
  nome       String
  telefone   String
  email      String?
  date       DateTime
  pessoas    Int
  observacao String?
  status     String   @default("PENDENTE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Models for future use (cardápio & pedidos)
model Category {
  id    Int     @id @default(autoincrement())
  key   String  @unique
  label String
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  imageUrl    String?
  available   Boolean  @default(true)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Order models (sketch for future)
model Order {
  id           Int      @id @default(autoincrement())
  tableNumber  String
  customerName String?
  items        String   @default("[]")
  total        Float    @default(0)
  status       String   @default("aberta")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Curriculum {
  id           Int      @id @default(autoincrement())
  nome         String
  telefone     String
  email        String
  mensagem     String?
  fileName     String
  originalName String
  fileUrl      String
  mimeType     String
  size         Int
  status       String   @default("NOVO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
